# ============================================================================
# MindKNUST Mobile App — Environment Configuration Template
# ============================================================================
# IMPORTANT: NEVER commit real credentials or .env files to source control.
# Rotate all API keys before public production deployment.
# ============================================================================

# ── Supabase API Settings ───────────────────────────────────────────────────
# Get keys from: Supabase Dashboard > Project Settings > API
# - EXPO_PUBLIC_SUPABASE_URL: Project HTTPS URL
# - EXPO_PUBLIC_SUPABASE_ANON_KEY: Public Anon Key (safe for client-side use with RLS enabled)
# - NEVER expose the SUPABASE_SERVICE_ROLE_KEY in client apps.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Firebase Authentication Settings ────────────────────────────────────────
# Get keys from: Firebase Console > Project Settings > General > Web Apps
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# ── Hugging Face Inference API ───────────────────────────────────────────────
# Get token at: https://huggingface.co/settings/tokens
# (Used for AI sentiment analysis, crisis classification, and toxicity checks)
EXPO_PUBLIC_HF_API_KEY=hf_your_token_here

# ── 100MS Video Calling (Optional Fallback) ──────────────────────────────────
EXPO_PUBLIC_100MS_AUTH_TOKEN=your_100ms_auth_token_here
EXPO_PUBLIC_100MS_ROOM_CODE=your_100ms_room_code_here
